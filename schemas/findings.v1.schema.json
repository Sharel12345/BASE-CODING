{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact": {
      "const": "performance_findings"
    },
    "run_id": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "timezone": {
          "const": "Asia/Jerusalem"
        },
        "compare_start": {
          "type": "string"
        },
        "compare_end": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "timezone",
        "compare_start",
        "compare_end"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "account": {
      "type": "object",
      "properties": {
        "platform": {
          "const": "meta"
        },
        "account_id": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "platform",
        "account_id",
        "currency"
      ],
      "additionalProperties": false
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "observation",
              "hypothesis"
            ]
          },
          "metric": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_ref": {
                  "type": "string"
                },
                "entity_ids": {
                  "type": "object",
                  "properties": {
                    "account": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "campaign": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "adset": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ad": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "creative": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "account",
                    "campaign",
                    "adset",
                    "ad",
                    "creative"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "source_ref",
                "entity_ids"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "finding_id",
          "claim",
          "kind",
          "metric",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "success_metric": {
            "type": "string"
          },
          "status": {
            "const": "proposed"
          }
        },
        "required": [
          "action_id",
          "text",
          "evidence_refs",
          "success_metric",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "artifact",
    "run_id",
    "period",
    "status",
    "account",
    "coverage_gaps",
    "findings",
    "actions"
  ],
  "additionalProperties": false
}
